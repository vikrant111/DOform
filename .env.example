# ─────────────────────────────────────────────────────────────
# CVP Requisition — ALL configuration lives in this file.
# Copy to `.env` and edit. Nothing is configured in code.
# Restart the app after changing anything here.
# ─────────────────────────────────────────────────────────────

# ── Identity / branding ──────────────────────────────────────
APP_NAME=CVP Requisition
UNIT_NAME=INS UTKROSH
FORM_TITLE=CASUAL VISITOR PASS (CVP)
FORM_FOOTER_NOTE=Visitors are to be escorted throughout their visit/ stay inside the unit. They are not to be allowed to visit any place other than specified.
UNIT_MOTTO=अदम्य साहस प्रचण्ड जोश – उत्क्रोश उत्क्रोश
SECURITY_OFFICE_LABEL=Security Officer, INS Utkrosh

# ── Form limits (rows in each table of the form) ─────────────
MAX_VISITORS=10
MAX_VEHICLES=5
MAX_ESCORTS=5

# ── Pass number ──────────────────────────────────────────────
# Generated automatically on first save:
#   <prefix>/<service no of the writer>/<DDMMYYYY>/<HHMMSS>
#   e.g. CVP/UTK/12345A/13102026/204530
PASS_NO_PREFIX=CVP/UTK

# Records written before the app generated pass numbers carry a hand-typed one
# (CVP-2026-0142) and no issue time, so their pass line prints the number with
# "at ____ Hrs on (Date) ____" left blank. A save replaces those; a record
# nobody edits again never gets there.
#
# on (default)  printing such a record issues a proper pass and writes it back,
#               so the paper and the record agree. Security Office only, and
#               written once — a reprint shows the same number.
# off           leave them as they are.
PASS_ON_PRINT=on

# ── Visitor photograph ───────────────────────────────────────
# A visitor row can carry a picture, taken with the camera or chosen from the
# machine. The page shrinks it to about 400px and re-encodes it as a JPEG
# before sending — roughly 30 KB — and the pass prints one photograph whichever
# visitor it belongs to. There is nothing to configure; it is noted here
# because the app asks the operating system for camera access the first time
# somebody presses "Take photo", and nothing else.
#
# Windows and macOS block the camera at the system level, outside anything the
# app controls:
#   Windows  Settings → Privacy & security → Camera → Let desktop apps access
#   macOS    System Settings → Privacy & Security → Camera
# Run `npm run check:camera` on the machine to confirm before relying on it.

# ── Database ─────────────────────────────────────────────────
# sqlite : one local file. No server, no install, works immediately.
#          This is the default and needs nothing else on the machine.
# mysql  : a shared MySQL server, for offices where several desktops must
#          write to one database. Requires MySQL to be installed.
DB_ENGINE=sqlite

# Where the sqlite file lives. Blank = the OS application-data folder:
#   Windows  %APPDATA%\CVP Requisition\doform.db
#   macOS    ~/Library/Application Support/CVP Requisition/doform.db
#   Linux    ~/.config/CVP Requisition/doform.db
DB_FILE=

# Only read when DB_ENGINE=mysql.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=doform
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=doform
MYSQL_CONNECTION_LIMIT=10
# Optional: point several desktops at one office PC over the LAN.
# Leave as 127.0.0.1 for a completely standalone machine.

# ── Authentication ───────────────────────────────────────────
AUTH_SCRYPT_COST=16384
AUTH_MIN_PASSWORD_LENGTH=8
# Lock an account out after this many wrong passwords in a row.
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=5
AUTH_SESSION_HOURS=12
ALLOW_SELF_SIGNUP=true
DEFAULT_ROLE=operator
# The first account created is always an administrator.

# ── Window ───────────────────────────────────────────────────
WINDOW_WIDTH=1280
WINDOW_HEIGHT=860
WINDOW_MIN_WIDTH=900
WINDOW_MIN_HEIGHT=600
START_MAXIMIZED=false

# ── Appearance ───────────────────────────────────────────────
THEME_PRIMARY=#14395e
THEME_ACCENT=#b8860b
DATE_FORMAT=DD/MM/YYYY

# ── Dashboard chart colours ──────────────────────────────────
# One hue for magnitude bars; status colours always sit beside their label.
CHART_BAR=#2a78d6
CHART_STATUS_DRAFT=#6b7a8a
CHART_STATUS_SUBMITTED=#fab219
CHART_STATUS_APPROVED=#0ca30c
CHART_STATUS_ISSUED=#2a78d6
CHART_STATUS_REJECTED=#d03b3b
DASHBOARD_DAYS=14

# ── Export ───────────────────────────────────────────────────
EXPORT_CSV_DELIMITER=,
# Rows per page in the Records list (1–200).
RECORDS_PAGE_SIZE=25
